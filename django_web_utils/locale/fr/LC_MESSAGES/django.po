#: admin_utils.py:47
msgid "Export selected objects as CSV file"
msgstr "Exporter les objets sélectionnés dans un fichier CSV"

#: admin_utils.py:112
msgid "CSV export"
msgstr "Export CSV"

#: antivirus_utils.py:47
msgid "Your request was reported and if you send again infected files, you will be banned."
msgstr "Votre requête a été signalée et si vous envoyez à nouveau des fichiers infectés, vous serez banni."

#: antivirus_utils.py:48
msgid "Failed to run antivirus scanner."
msgstr "Échec de l'exécution du scanner antivirus."

#: antivirus_utils.py:49
msgid "Cannot scan file because it does not exist."
msgstr "Impossible d'analyser le fichier car il n'existe pas."

#: antivirus_utils.py:50
msgid "Your file was rejected because it is infected."
msgstr "Votre fichier a été rejeté car il est infecté."

#: antivirus_utils.py:51
msgid "Cannot scan file because it is not a file."
msgstr "Impossible d'analyser le fichier car il ne s'agit pas d'un fichier."

#: antivirus_utils.py:52
msgid "Cannot scan file because it is neither a file nor a directory."
msgstr "Impossible d'analyser le fichier car ce n'est ni un fichier ni un répertoire."

#: antivirus_utils.py:53
msgid "Failed to scan your file with the antivirus."
msgstr "L'analyse de votre fichier par l'antivirus a échoué."

#: auth_utils.py:40
msgid "Your account is disabled."
msgstr "Votre compte est désactivé."

#: auth_utils.py:42
msgid "Your username and password do not match."
msgstr "Votre nom d'utilisateur et votre mot de passe ne correspondent pas."

#: auth_utils.py:44
msgid "Authentication required."
msgstr "Authentification requise."

#: auth_utils.py:47
msgid "Access authentication"
msgstr "Authentification d'accès"

#: auth_utils.py:84 auth_utils.py:92
msgid "The password must contain at least 3 types of characters (types are lower case letters, upper case letters, digits and special characters)."
msgstr "Le mot de passe doit contenir au minimum 3 types de caractères (les types sont : lettres minuscules, lettres majuscules, chiffres et caractères spéciaux)."

