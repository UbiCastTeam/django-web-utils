#: ldap_utils.py:75
msgid "Error when initializing connection with LDAP server."
msgstr "Erreur lors de l'initialisation de la connexion avec le serveur LDAP."

#: ldap_utils.py:75 ldap_utils.py:105 ldap_utils.py:140 ldap_utils.py:336
msgid "Error:"
msgstr "Erreur :"

#: ldap_utils.py:105
msgid "Error when trying to authenticate on LDAP server."
msgstr "Erreur lors de l'authentification sur le serveur LDAP."

#: ldap_utils.py:139
msgid "Search on LDAP server failed."
msgstr "Recherche échouée sur le serveur LDAP."

#: ldap_utils.py:142
msgid "Arguments:"
msgstr "Arguments :"

#: ldap_utils.py:180
msgid "User not found."
msgstr "Utilisateur introuvable."

#: ldap_utils.py:199
msgid "Group not found."
msgstr "Groupe introuvable."

#: ldap_utils.py:336
msgid "Error when trying to get user information."
msgstr "Erreur lors de la récupération des informations de l'utilisateur."

#: ldap_utils.py:346
msgid "Login failed (however the user exists in LDAP)."
msgstr "Échec de l'authentification (l'utilisateur existe bien dans LDAP)."

#: ldap_utils.py:350
msgid "Login succeeded."
msgstr "Authentification réussie."

