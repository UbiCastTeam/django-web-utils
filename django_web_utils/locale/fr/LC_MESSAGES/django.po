msgid "Error when trying to get groups."
msgstr "Erreur lors de la récupération des groupes de l'utilisateur."

#: ldap_utils.py:372
msgid "No groups found."
msgstr "Aucun groupe n'a été trouvé."

#: magic_login/forms.py:11
msgid "Email address"
msgstr "Adresse e-mail"

#: magic_login/forms.py:16
msgid "Invalid email address."
msgstr "L'adresse e-mail n'est pas valide."

#: magic_login/views.py:115
msgid "The submitted form is incorrect. Please correct all errors and send it again."
msgstr "Le formulaire saisi est incorrect. Veuillez corriger les erreurs puis le renvoyer."

#: magic_login/views.py:128
msgid "The requested email address is not allowed."
msgstr "L'adresse e-mail demandée n'est pas autorisée."

#: magic_login/views.py:137
#, python-format
msgid "Link to authenticate on %s"
msgstr "Lien pour s'authentifier sur %s"

#: magic_login/views.py:148
msgid "Here is the link to log in on the site:"
msgstr "Voici le lien pour s'authentifier sur le site :"

#: magic_login/views.py:149
msgid "If you did not request this link, ignore this email."
msgstr "Si vous n'avez pas demandé ce lien, ignorez cet e-mail."

#: magic_login/views.py:162
msgid "Failed to send the email:"
msgstr "L'envoi de l'e-mail a échoué :"

#: magic_login/views.py:164
msgid "An email has been sent to you with the link to log in."
msgstr "Un e-mail vous a été envoyé avec le lien pour vous connecter."

#: magic_login/views.py:169
msgid "Your session has expired, please get a new link to retry."
msgstr "Votre session a expiré, veuillez obtenir un nouveau lien pour réessayer."

#: magic_login/views.py:173
msgid "Your request is invalid."
msgstr "Votre requête n'est pas valide."

#: settings_store/forms.py:86 settings_utils.py:64 settings_utils.py:125
msgid "No changes to save."
msgstr "Aucune modification à sauvegarder."

#: settings_store/forms.py:89
msgid "Your changes will be active in a few seconds."
msgstr "Vos modifications seront actives dans quelques secondes."

#: settings_utils.py:69 settings_utils.py:131
#, python-format
msgid "Invalid setting name: %s"
msgstr "Nom de paramètre non valide : %s"

#: settings_utils.py:79 settings_utils.py:141
msgid "Your changes were not saved but were applied to the running software."
msgstr "Vos modifications n'ont pas été sauvegardées mais ont été appliquées à l'application en cours."

#: settings_utils.py:113 settings_utils.py:170
msgid "Unable to write configuration file:"
msgstr "Impossible d'écrire le fichier de configuration :"

#: settings_utils.py:115 settings_utils.py:172
msgid "Your changes have been applied. The service will be reloaded in a few seconds to make them effective."
msgstr "Vos modifications ont été appliquées. Le service sera rechargé dans quelques secondes pour les rendre effectives."

