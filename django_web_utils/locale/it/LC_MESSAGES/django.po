#: admin_utils.py:12
msgid "Export selected objects as CSV file"
msgstr "Esportazione degli oggetti selezionati come file CSV"

#: admin_utils.py:110
msgid "CSV export"
msgstr "Esportazione CSV"

#: antivirus_utils.py:47
msgid "Your request was reported and if you send again infected files, you will be banned."
msgstr "La tua richiesta è stata segnalata e se invierai nuovamente file infetti, sarai bannato."

#: antivirus_utils.py:48
msgid "Failed to run antivirus scanner."
msgstr "Impossibile eseguire la scansione antivirus."

#: antivirus_utils.py:49
msgid "Cannot scan file because it does not exist."
msgstr "Impossibile eseguire la scansione del file perché non esiste."

#: antivirus_utils.py:50
msgid "Your file was rejected because it is infected."
msgstr "Il file è stato rifiutato perché infetto."

#: antivirus_utils.py:51
msgid "Cannot scan file because it is not a file."
msgstr "Impossibile eseguire la scansione del file perché non è un file."

#: antivirus_utils.py:52
msgid "Cannot scan file because it is neither a file nor a directory."
msgstr "Impossibile eseguire la scansione del file perché non è né un file né una directory."

#: antivirus_utils.py:53
msgid "Failed to scan your file with the antivirus."
msgstr "Non è riuscita la scansione del file con l'antivirus."

#: auth_utils.py:40
msgid "Your account is disabled."
msgstr "Il vostro account è disattivato."

#: auth_utils.py:42
msgid "Your username and password do not match."
msgstr "Il nome utente e la password non corrispondono."

#: auth_utils.py:44
msgid "Authentication required."
msgstr "È richiesta l'autenticazione."

#: auth_utils.py:47
msgid "Access authentication"
msgstr "Autenticazione di accesso"

#: auth_utils.py:83 auth_utils.py:88
msgid "The password must contain at least 3 types of characters (types are lower case letters, upper case letters, digits and special characters)."
msgstr "La password deve contenere almeno 3 tipi di caratteri (i tipi sono lettere minuscole, lettere maiuscole, cifre e caratteri speciali)."

#: files_utils.py:63
msgid "B"
msgstr "B"

