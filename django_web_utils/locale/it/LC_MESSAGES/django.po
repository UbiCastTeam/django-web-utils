msgid "Yes"
msgstr "Sì"

#: forms_utils.py:121 settings_store/forms.py:50
msgid "No"
msgstr "No"

#: json_utils.py:89
msgid "Invalid request method"
msgstr "Metodo di richiesta non valido"

#: json_utils.py:94
msgid "Authentication required"
msgstr "È richiesta l'autenticazione"

#: json_utils.py:125
msgid "Bad request"
msgstr "Richiesta negativa"

#: json_utils.py:127
msgid "Access denied"
msgstr "Accesso negato"

#: json_utils.py:129
msgid "Page not found"
msgstr "Pagina non trovata"

#: json_utils.py:134
msgid "Infected file detected"
msgstr "Rilevato un file infetto"

#: json_utils.py:143
msgid "Internal server error"
msgstr "Errore interno del server"

#: ldap_utils.py:74
msgid "Error when initializing connection with LDAP server."
msgstr "Errore durante l'inizializzazione della connessione con il server LDAP."

#: ldap_utils.py:74 ldap_utils.py:102 ldap_utils.py:129 ldap_utils.py:280
msgid "Error:"
msgstr "Errore:"

#: ldap_utils.py:102
msgid "Error when trying to authenticate on LDAP server."
msgstr "Errore durante il tentativo di autenticazione sul server LDAP."

#: ldap_utils.py:128
msgid "Search on LDAP server failed."
msgstr "La ricerca sul server LDAP non è riuscita."

#: ldap_utils.py:131
msgid "Arguments:"
msgstr "Argomenti:"

#: ldap_utils.py:165
msgid "User not found."
msgstr "Utente non trovato."

#: ldap_utils.py:177
msgid "Group not found."
msgstr "Gruppo non trovato."

#: ldap_utils.py:280
msgid "Error when trying to get user information."
msgstr "Errore durante il tentativo di ottenere informazioni sull'utente."

#: ldap_utils.py:289
msgid "Login failed (however the user exists in LDAP)."
msgstr "Accesso fallito (tuttavia l'utente esiste in LDAP)."

#: ldap_utils.py:291
msgid "Login succeeded."
msgstr "Accesso riuscito."

#: ldap_utils.py:292
#, python-format
msgid "User \"%s\" data:"
msgstr "Dati dell'utente \"%s\":"

#: ldap_utils.py:297
msgid "User groups:"
msgstr "Gruppi di utenti:"

#: ldap_utils.py:302
msgid "Error when trying to get groups."
msgstr "Errore durante il tentativo di ottenere i gruppi."

#: ldap_utils.py:313
msgid "No groups found."
msgstr "Nessun gruppo trovato."

#: magic_login/forms.py:11
msgid "Email address"
msgstr "Indirizzo e-mail"

#: magic_login/forms.py:16
msgid "Invalid email address."
msgstr "Indirizzo e-mail non valido."

#: magic_login/views.py:115
msgid "The submitted form is incorrect. Please correct all errors and send it again."
msgstr "Il modulo inviato non è corretto. Si prega di correggere tutti gli errori e di inviarlo nuovamente."

#: magic_login/views.py:128
msgid "The requested email address is not allowed."
msgstr "L'indirizzo e-mail richiesto non è consentito."

#: magic_login/views.py:137
#, python-format
msgid "Link to authenticate on %s"
msgstr "Link per l'autenticazione su %s"

#: magic_login/views.py:148
msgid "Here is the link to log in on the site:"
msgstr "Ecco il link per accedere al sito:"

#: magic_login/views.py:149
msgid "If you did not request this link, ignore this email."
msgstr "Se non avete richiesto questo link, ignorate questa e-mail."

#: magic_login/views.py:162
msgid "Failed to send the email:"
msgstr "Non è stato possibile inviare l'e-mail:"

#: magic_login/views.py:164
msgid "An email has been sent to you with the link to log in."
msgstr "Le è stata inviata un'e-mail con il link per accedere."

#: magic_login/views.py:169
msgid "Your session has expired, please get a new link to retry."
msgstr "La sessione è scaduta, si prega di ottenere un nuovo link per riprovare."

#: magic_login/views.py:173
msgid "Your request is invalid."
msgstr "La richiesta non è valida."

#: settings_store/forms.py:81 settings_utils.py:64 settings_utils.py:125
msgid "No changes to save."
msgstr "Non ci sono modifiche da salvare."

#: settings_store/forms.py:84
msgid "Your changes will be active in a few seconds."
msgstr "Le modifiche saranno attive in pochi secondi."

#: settings_utils.py:69 settings_utils.py:131
#, python-format
msgid "Invalid setting name: %s"
msgstr "Nome dell'impostazione non valido: %s"

#: settings_utils.py:79 settings_utils.py:141
msgid "Your changes were not saved but were applied to the running software."
msgstr "Le modifiche non sono state salvate, ma sono state applicate al software in esecuzione."

#: settings_utils.py:113 settings_utils.py:170
msgid "Unable to write configuration file:"
msgstr "Impossibile scrivere il file di configurazione:"

#: settings_utils.py:115 settings_utils.py:172
msgid "Your changes have been applied. The service will be reloaded in a few seconds to make them effective."
msgstr "Le modifiche sono state applicate. Il servizio verrà ricaricato tra qualche secondo per renderle effettive."

